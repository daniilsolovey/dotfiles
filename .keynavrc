clear
daemonize

# Super+Z -> включить режим мышки
super+z start

# движение — через xdotool, как в старом варианте
h sh "xdotool mousemove_relative -- -20 0"
j sh "xdotool mousemove_relative -- 0 20"
k sh "xdotool mousemove_relative -- 0 -20"
l sh "xdotool mousemove_relative -- 20 0"

# клики
q click 1
w click 2
e click 3

# скролл
r click 4
f click 5

# выход
Escape end
F24 end
