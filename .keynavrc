clear
daemonize

# Super+Z -> включить режим мышки
super+z start

# движение — через xdotool, как в старом варианте
h sh "xdotool mousemove_relative -- -15 0"
j sh "xdotool mousemove_relative -- 0 15"
k sh "xdotool mousemove_relative -- 0 -15"
l sh "xdotool mousemove_relative -- 15 0"

# клики
q click 1
a sh "/home/operator/Scripts/mouse-drag-toggle.sh"
s sh "/home/operator/Scripts/screenshot-keyboard-point.sh"
w click 2
e click 3

# скролл
r click 4
f click 5

# выход
Escape end
F24 sh "xdotool mouseup 1; rm -f ${XDG_RUNTIME_DIR}/keyboard-mouse-drag",end